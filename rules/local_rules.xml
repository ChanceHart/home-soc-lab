<!--
  Home SOC Lab: custom Wazuh detection rules (IDs 100100-100199)
  Each rule maps to a MITRE ATT&CK technique and has a safe test in tests/.
-->
<group name="local,homelab,">

  <!-- 1. Brute force: 5+ failed Windows logons within 2 minutes (Event 4625) -->
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <description>Lab: possible brute force, 5+ failed Windows logons in 2 minutes</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- 2. New local admin: a member was added to the Administrators group (Event 4732) -->
  <rule id="100110" level="12">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^administrators$</field>
    <description>Lab: account added to the local Administrators group</description>
    <mitre><id>T1098</id><id>T1136.001</id></mitre>
    <group>privilege_escalation,account_changed,</group>
  </rule>

  <!-- 3. Suspicious PowerShell: encoded or download-and-run commands (Sysmon Event 1) -->
  <rule id="100120" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\b(powershell|pwsh)\.exe$</field>
    <!-- Tuned 2026-10-06: "-ExecutionPolicy Bypass" alone was removed; normal admin and dev tools use it all day (false positives). -->
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\s-e(nc|ncodedcommand)?\s|downloadstring|downloadfile|invoke-webrequest|\biex\b|frombase64string)</field>
    <description>Lab: suspicious PowerShell (encoded or download-and-run command)</description>
    <mitre><id>T1059.001</id><id>T1027</id></mitre>
    <group>execution,powershell,</group>
  </rule>

  <!-- 4. Persistence: scheduled task created from the command line (Sysmon Event 1) -->
  <rule id="100130" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\bschtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Lab: scheduled task created with schtasks.exe</description>
    <mitre><id>T1053.005</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- 4b. Persistence: new Windows service installed (System Event 7045) -->
  <rule id="100131" level="10">
    <if_sid>61138</if_sid>
    <description>Lab: new Windows service installed: $(win.eventdata.serviceName)</description>
    <mitre><id>T1543.003</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- 5. Discovery: account and system reconnaissance commands (Sysmon Event 1) -->
  <rule id="100140" level="6">
    <if_group>sysmon_event1</if_group>
    <!-- Tuned 2026-10-06: net.exe only counts for account/group/share lookups, not "net start/stop" (Windows does that constantly). -->
    <field name="win.eventdata.image" type="pcre2">(?i)\b(whoami|systeminfo|net1?|nltest|quser)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(whoami|systeminfo|nltest|quser|\bnet1?(\.exe)?"?\s+(user|group|localgroup|accounts|share|view|session)\b)</field>
    <!-- Tuned 2026-10-06 (triage): Wazuh's own CIS scan runs "net accounts" and similar checks -->
    <field name="win.eventdata.parentImage" type="pcre2" negate="yes">(?i)\\+ossec-agent\\+wazuh-agent\.exe$</field>
    <description>Lab: discovery command run: $(win.eventdata.commandLine)</description>
    <mitre><id>T1033</id><id>T1087.001</id><id>T1082</id></mitre>
    <group>discovery,</group>
  </rule>

  <!-- 5b. Recon burst: 3+ discovery commands within 1 minute -->
  <rule id="100141" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100140</if_matched_sid>
    <description>Lab: burst of discovery commands (3+ in 1 minute), possible hands-on-keyboard attacker</description>
    <mitre><id>T1033</id><id>T1087.001</id><id>T1082</id></mitre>
    <group>discovery,</group>
  </rule>

  <!-- 5c. Tuned 2026-10-06 (triage): "net user" starts net1.exe, so one command counted twice toward the burst -->
  <rule id="100142" level="0">
    <if_sid>100140</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+net1\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+net\.exe$</field>
    <description>Lab: net1.exe child of net.exe (already counted)</description>
  </rule>

  <!-- 6. Malware defense: the YARA/VirusTotal scanner quarantined a file (agent active-response log) -->
  <rule id="100150" level="12">
    <match>homelab-av: QUARANTINED</match>
    <description>Lab: malicious file quarantined by the lab scanner</description>
    <mitre><id>T1204.002</id></mitre>
    <group>malware,quarantine,</group>
  </rule>

  <rule id="100151" level="5">
    <match>homelab-av: ERROR</match>
    <description>Lab: file scanner error</description>
    <group>malware,</group>
  </rule>

  <!--
    7. Tuning from alert triage (2026-10-06). Each rule is narrow on purpose: it matches the exact benign
       pattern that was investigated and verified, so the parent rule still fires for anything else.
  -->

  <!-- PowerShell writes __PSScriptPolicyTest_*.ps1/.psm1 to Temp on every start (AppLocker/WDAC policy check).
       223 alerts in one day (rules 92213 level 15, 92205 level 9), all from this one file name. -->
  <rule id="100160" level="0">
    <if_sid>92213, 92205</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\+__PSScriptPolicyTest_[a-z0-9]+\.[a-z0-9]+\.ps(1|m1)$</field>
    <description>Lab tuning: PowerShell policy-test file (benign, created on every PowerShell start)</description>
    <group>tuning,</group>
  </rule>

  <!-- Opera's signed auto-updater unpacks installers in Temp. Kept visible at low level instead of level 15. -->
  <rule id="100161" level="3">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+Opera\\+autoupdate\\+opera_autoupdate\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\+Temp\\+\.opera\\+[0-9A-F]+\\+[a-z_]*installer\.exe$</field>
    <description>Lab tuning: Opera auto-updater dropped its installer in Temp (verified signed by Opera Norway AS)</description>
    <group>tuning,</group>
  </rule>

  <!-- Built-in "suspicious host process" rules fire when Sysmon has no parent for a genuine Windows host process.
       Only downgraded when the binary is the real one in System32 and the command line is the normal service form. -->
  <rule id="100162" level="3">
    <if_sid>61618</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+System32\\+svchost\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)svchost\.exe"? -k [a-z]+ -p -s [a-z0-9]+$</field>
    <description>Lab tuning: svchost.exe hosting a named service from System32 (parent not recorded)</description>
    <group>tuning,</group>
  </rule>

  <rule id="100163" level="3">
    <if_sid>61634, 61638</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+System32\\+(backgroundTaskHost|dllhost)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-ServerName:[A-Za-z0-9._]+$|/Processid:\{[0-9A-F-]{36}\}$)</field>
    <description>Lab tuning: Windows background task / COM host from System32 (parent not recorded)</description>
    <group>tuning,</group>
  </rule>

  <!-- sdbinst.exe started by the Program Compatibility Assistant service (PcaSvc) is normal Windows behavior -->
  <rule id="100164" level="3">
    <if_sid>92058</if_sid>
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)svchost\.exe -k LocalSystemNetworkRestricted -p -s PcaSvc$</field>
    <description>Lab tuning: Application Compatibility Database installed by PcaSvc</description>
    <group>tuning,</group>
  </rule>

</group>
